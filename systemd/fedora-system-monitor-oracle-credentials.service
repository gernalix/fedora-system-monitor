[Unit]
Description=Prepare Oracle monitor endpoint credentials from Bitwarden
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/bws-files --ref ORACLE_SYSTEM_MONITOR_PROBE_ENV --file oracle_push_toml=ORACLE_PUSH_TOML_BASE64
UMask=0077
LimitCORE=0
TimeoutStartSec=100
