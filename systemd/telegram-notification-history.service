[Unit]
Description=Sync the configured technical Telegram notification chat to its private archive
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/fedora-telegram-history/collector.env
ConditionPathExists=%h/.local/share/fedora-telegram-history/account.session

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 120 %h/.cache/fedora-telegram-history/session.lock /home/daniele/.local/libexec/fedora-telegram-history/venv/bin/python /home/daniele/.local/libexec/fedora-telegram-history/telegram_history_collector.py sync --config %h/.config/fedora-telegram-history/collector.env
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/projects/telegram-notification-history %h/.local/share/fedora-telegram-history %h/.cache/fedora-telegram-history
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
