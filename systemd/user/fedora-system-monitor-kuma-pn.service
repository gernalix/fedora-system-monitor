[Unit]
Description=Register Uptime Kuma DOWN incidents as canonical MegaVault Pn
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.local/libexec/fedora-system-monitor-kuma-pn/fedora_system_monitor/capsules/kuma_pn_monitor.py

[Service]
Type=oneshot
Environment=PYTHONPATH=%h/.local/libexec/fedora-system-monitor-kuma-pn
ExecStart=/usr/bin/python3 -m fedora_system_monitor.capsules.kuma_pn_monitor
TimeoutStartSec=360
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
