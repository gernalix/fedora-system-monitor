[Unit]
# C3 retired; historical definition retained, never start/install as active.
ConditionPathExists=/nonexistent/c3-permanently-retired
Description=Poll current Uptime Kuma heartbeat events for C2 Inbox capture

[Timer]
OnBootSec=15s
OnUnitActiveSec=30s
AccuracySec=3s
Unit=fedora-system-monitor-kuma-c2-bridge.service

[Install]
WantedBy=timers.target

