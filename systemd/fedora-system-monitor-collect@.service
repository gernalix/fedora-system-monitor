[Unit]
Description=Fedora System Monitor collector (%i)
Documentation=file:/home/daniele/projects/fedora-system-monitor/docs/human/overview.md
After=local-fs.target NetworkManager.service

[Service]
Type=oneshot
User=root
Group=daniele
ExecStart=/usr/local/bin/fedora-system-monitor collect %i
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
UMask=0027
StateDirectory=fedora-system-monitor
StateDirectoryMode=0750
RuntimeDirectory=fedora-system-monitor
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
ReadWritePaths=/var/lib/fedora-system-monitor /run/fedora-system-monitor
InaccessiblePaths=-/home/daniele/.ssh -/home/daniele/.config/gh -/home/daniele/.codex -/home/daniele/.mozilla -/home/daniele/.config/google-chrome -/home/daniele/.pki
