#!/bin/bash
set -u

case "${1:-}" in
    pre)
        /usr/bin/timeout 3 /usr/local/bin/fedora-system-monitor hook suspend >/dev/null 2>&1 || /usr/bin/logger -t fedora-system-monitor-hook '{"event":"hook_failed","hook":"suspend"}'
        ;;
    post)
        /usr/bin/timeout 3 /usr/local/bin/fedora-system-monitor hook resume >/dev/null 2>&1 || /usr/bin/logger -t fedora-system-monitor-hook '{"event":"hook_failed","hook":"resume"}'
        /usr/bin/systemctl --no-block start fedora-system-monitor-collect@five_minute.service >/dev/null 2>&1 || true
        ;;
esac

exit 0
