# Copy to ~/.config/fedora-telegram-history/collector.env and fill locally.
# chmod 600 ~/.config/fedora-telegram-history/collector.env
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHAT=
SESSION_FILE=~/.local/share/fedora-telegram-history/account
DATA_REPO=~/projects/telegram-notification-history
DATA_REMOTE=https://github.com/gernalix/telegram-notification-history.git
