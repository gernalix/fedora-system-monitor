# Reuse the already-authorized account-level collector config.
# chmod 600 ~/.config/fedora-telegram-autodelete/collector.env
BASE_CONFIG=~/.config/fedora-telegram-history/collector.env
# Use a dedicated Telethon session for the long-running watcher.
SESSION_FILE=~/.local/share/fedora-telegram-autodelete/account

# Leave blank to auto-discover exactly one recent dialog with a 1-day TTL.
# If discovery finds more than one candidate, set this to the desired peer ID.
TELEGRAM_CHAT=

AUTO_DELETE_TTL_SECONDS=86400
RECONCILE_HORIZON_SECONDS=108000
RECONCILE_INTERVAL_SECONDS=60
DISCOVERY_LIMIT=50

ARCHIVE_DB=~/.local/share/fedora-telegram-autodelete/archive.sqlite3
STATE_DIR=~/.local/share/fedora-telegram-autodelete
MEDIA_DIR=~/.local/share/fedora-telegram-autodelete/media

# Finite media limits in bytes: 100 MiB/file, 10 GiB retained media, 1 GiB free reserve.
# All must be positive. Existing/retained media is counted and never pruned.
# Oversized/full/unavailable downloads are skipped; message metadata still syncs.
MEDIA_MAX_FILE_BYTES=104857600
MEDIA_MAX_ARCHIVE_BYTES=10737418240
MEDIA_MIN_FREE_BYTES=1073741824
# Bound filesystem metadata too: files, directories, lock and partials all count.
# Leave at least 1,024 inodes free when the filesystem reports inode totals.
# Filesystems without inode totals still enforce the finite entry budget.
MEDIA_MAX_ENTRIES=50000
MEDIA_MIN_FREE_INODES=1024
