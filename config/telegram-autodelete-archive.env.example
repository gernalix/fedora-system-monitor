# Reuse the already-authorized account-level collector config.
# chmod 600 ~/.config/fedora-telegram-autodelete/collector.env
BASE_CONFIG=~/.config/fedora-telegram-history/collector.env

# Leave blank to auto-discover exactly one recent dialog with a 1-day TTL.
# If discovery finds more than one candidate, set this to the desired peer ID.
TELEGRAM_CHAT=

AUTO_DELETE_TTL_SECONDS=86400
RECONCILE_HORIZON_SECONDS=108000
DISCOVERY_LIMIT=50

ARCHIVE_DB=~/.local/share/fedora-telegram-autodelete/archive.sqlite3
STATE_DIR=~/.local/share/fedora-telegram-autodelete
MEDIA_DIR=~/.local/share/fedora-telegram-autodelete/media
