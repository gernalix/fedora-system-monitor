{
  "manifest_version": 3,
  "name": "FSM Schede Chrome",
  "version": "1.0.0",
  "description": "Schede effimere, limiti di attribuzione espliciti e scaricamento/chiusura solo su scelta confermata.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FSM Schede Chrome"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
